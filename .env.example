# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (Atlas replica set required for Prisma)
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/doctor_tracker?retryWrites=true&w=majority"

# Auth: JWT_SECRET must be at least 16 characters
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_long_random_secret_here
JWT_EXPIRES_IN=7d

# Allowed frontend origin for CORS (no trailing slash)
CLIENT_URL=http://localhost:3000

# Parent domain for the auth cookie in production, e.g. .example.com
# Leave empty locally. Needed when frontend and API are on different subdomains
COOKIE_DOMAIN=

# Used by `npm run seed` to create the admin user (password min 8 characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!